{
  "name": "@yassir-jeraidi/pdf-templates",
  "version": "0.1.1",
  "description": "Production-ready PDF template engine for Node.js and TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "binaries",
    "pdf-template-napi.node"
  ],
  "bin": {
    "pdf-template": "./bin/cli.js",
    "pdf-templates": "./bin/cli.js"
  },
  "scripts": {
    "build:rust": "cargo build --release -p pdf-template-napi",
    "copy:binding": "node scripts/copy-binding.js",
    "build:ts": "tsc",
    "build": "npm run copy:binding && npm run build:ts",
    "test": "node --test ../../tests/*.test.mjs"
  },
  "keywords": [
    "pdf",
    "template",
    "pdf-template",
    "pdf-engine",
    "docx-templates",
    "invoice",
    "report",
    "document-generator"
  ],
  "author": "Yassir Jeraidi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yassir-jeraidi/pdf-templates.git"
  },
  "homepage": "https://github.com/yassir-jeraidi/pdf-templates#readme",
  "bugs": {
    "url": "https://github.com/yassir-jeraidi/pdf-templates/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
